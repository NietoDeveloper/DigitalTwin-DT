{
  "name": "digital-twin-dt",
  "version": "1.0.0",
  "private": true,
  "description": "Public commercial showcase of Digital Twin DT: video + photos in, navigable 3D digital twin out.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @dtdt/api",
    "dev:web": "npm run dev -w @dtdt/web",
    "build": "npm run build -w @dtdt/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check:public": "node scripts/check-public.mjs",
    "verify": "npm run typecheck && npm test && npm run check:public && npm run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
