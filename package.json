{
  "name": "digital-twin-dt",
  "version": "1.0.0",
  "private": true,
  "description": "Commercial & technical showcase of Digital Twin Video DT. Runs locally.",
  "license": "MIT",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w @dtdt/api\" \"npm run dev -w @dtdt/web\"",
    "build": "npm run build -w @dtdt/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  }
}
